# ==============================================================================
# Configuracion de entorno para desarrollo local.
#
#   cp .env.example .env
#
# ==============================================================================

# ------------------------------------------------------------------ auth-service
POSTGRES_AUTH_DB=social_auth
POSTGRES_AUTH_USER=auth_service
POSTGRES_AUTH_PASSWORD=

# ------------------------------------------------------------------ post-service
POSTGRES_POSTS_DB=social_posts
POSTGRES_POSTS_USER=post_service
POSTGRES_POSTS_PASSWORD=

# --------------------------------------------------------------------------- JWT
JWT_SECRET=
JWT_ISSUER=social-auth-service
JWT_EXPIRATION_MINUTES=60

# ---------------------------------------------------------------------- Frontend.
API_BASE_URL=/api
APP_NAME=Red Social
POSTS_PAGE_SIZE=20
SESSION_EXPIRY_WARNING_SECONDS=60

# --------------------------------------------- Puertos publicados en el anfitrion
FRONTEND_PORT=4200
GATEWAY_PORT=8080
AUTH_SERVICE_PORT=8081
POST_SERVICE_PORT=8082
POSTGRES_AUTH_PORT=5433
POSTGRES_POSTS_PORT=5434
